	-- 2. Desvanecer GUI Cop por completo
	local fadeCop = TweenService:Create(CopFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1
