	TweenService:Create(CopStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
	
	fadeCop:Play()
	fadeCop.Completed:Wait()
	CopFrame:Destroy()
	
	-- 3. Transición: GUI Advertencia aparece AGRANDÁNDOSE desde el centro
	WarnFrame.Visible = true
	WarnFrame.Active = true
	
	local expandInfo = TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(WarnFrame, expandInfo, {
		Size = UDim2.new(0, 380, 0, 240),
