-- ESP & Marker
local function removeESP()
	if espConnection then espConnection:Disconnect() espConnection = nil end
	if currentHighlight then currentHighlight:Destroy() currentHighlight = nil end
	if currentBillboard then currentBillboard:Destroy() currentBillboard = nil end
end

local function applyESP(player)
	removeESP()
	if not player or not player.Character then return end

	local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
	if head then
		local bb = Instance.new("BillboardGui")
		bb.Name = "TargetTracker_VectorMarker"
		bb.Size = UDim2.new(0, 140, 0, 60)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = head

		local vectorPointer = Instance.new("TextLabel")
		vectorPointer.Size = UDim2.new(1, 0, 0.5, 0)
		vectorPointer.BackgroundTransparency = 1
		vectorPointer.Text = "▼"
		vectorPointer.TextColor3 = Color3.fromRGB(255, 55, 85)
		vectorPointer.TextSize = 22
		vectorPointer.Font = Enum.Font.FredokaOne
		vectorPointer.Parent = bb

		local labelTag = Instance.new("TextLabel")
