-- Seguimiento
local function stopFollowing()
	following = false
	ToggleButton.Text = T.btnStart
	ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 180, 120)
	Camera.CameraType = Enum.CameraType.Custom
	
	if followConnection then followConnection:Disconnect() followConnection = nil end
	if selectedPlayer then applyESP(selectedPlayer) end
end

ToggleButton.MouseButton1Click:Connect(function()
	if not MainFrame.Active then return end
	if following then
		stopFollowing()
	else
		local target = selectedPlayer
		if not target and TextBox.Text ~= "" then
			local nameText = string.lower(TextBox.Text)
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and (string.find(string.lower(player.Name), nameText) or string.find(string.lower(player.DisplayName), nameText)) then
					target = player
					break
				end
			end
		end
		
		if not target then
			pcall(function()
				StarterGui:SetCore("SendNotification", {Title = T.noTargetTitle, Text = T.noTargetText, Duration = 3})
			end)
			return
		end

		following = true
		removeESP()
		ToggleButton.Text = T.btnStop
		ToggleButton.BackgroundColor3 = Color3.fromRGB(235, 55, 85)
		
		followConnection = RunService.RenderStepped:Connect(function()
			local myChar = LocalPlayer.Character
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local targetChar = target.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
			
			if targetChar and targetHRP and targetHum and targetHum.Health > 0 and myHRP then
				Camera.CameraType = Enum.CameraType.Scriptable
				
				local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, FollowDistance)
				myHRP.CFrame = targetCFrame
				myHRP.CFrame = CFrame.lookAt(myHRP.Position, Vector3.new(targetHRP.Position.X, myHRP.Position.Y, targetHRP.Position.Z))
				
				local headPos = targetChar:FindFirstChild("Head") and targetChar.Head.Position or targetHRP.Position
				Camera.CFrame = CFrame.lookAt(myHRP.Position + Vector3.new(0, 4, 0), headPos)
			else
				Camera.CameraType = Enum.CameraType.Custom
			end
		end)
	end
end)

