	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 55, 85)
	highlight.OutlineTransparency = 0
	highlight.Adornee = player.Character
	highlight.Parent = player.Character
	currentHighlight = highlight

