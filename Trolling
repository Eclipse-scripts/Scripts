-- --------------------------------------------------------------------
-- LÓGICA DE SEGUIMIENTO Y CÁMARA
-- --------------------------------------------------------------------
local following = false
local followConnection = nil

local function getTargetPlayer(nameText)
	if selectedPlayer then return selectedPlayer end
	if not nameText or string.gsub(nameText, "%s+", "") == "" then return nil end
	
	nameText = string.lower(nameText)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if string.find(string.lower(player.Name), nameText) or string.find(string.lower(player.DisplayName), nameText) then
				return player
			end
		end
	end
	return nil
end

local function stopFollowing()
	following = false
	ToggleButton.Text = T.btnStart
	ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
	Camera.CameraType = Enum.CameraType.Custom
	
	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end
	
	if selectedPlayer then
		applyESP(selectedPlayer)
	end
end

ToggleButton.MouseButton1Click:Connect(function()
	if not MainFrame.Active then return end
	if following then
		stopFollowing()
	else
		local target = getTargetPlayer(TextBox.Text)
		
		if not target then
			pcall(function()
				StarterGui:SetCore("SendNotification", {
					Title = T.noTargetTitle,
					Text = T.noTargetText,
					Duration = 4
				})
			end)
			return
		end

		following = true
		removeESP()
		ToggleButton.Text = T.btnStop
		ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		
		followConnection = RunService.RenderStepped:Connect(function()
			local myChar = LocalPlayer.Character
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local targetChar = target.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
			
			local isTargetAlive = targetChar and targetHRP and targetHumanoid and targetHumanoid.Health > 0
			
			if isTargetAlive and myHRP then
				Camera.CameraType = Enum.CameraType.Scriptable
				
				local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, 10)
				myHRP.CFrame = targetCFrame
				myHRP.CFrame = CFrame.lookAt(myHRP.Position, Vector3.new(targetHRP.Position.X, myHRP.Position.Y, targetHRP.Position.Z))
				
				local headPos = targetChar:FindFirstChild("Head") and targetChar.Head.Position or targetHRP.Position
				Camera.CFrame = CFrame.lookAt(myHRP.Position + Vector3.new(0, 5, 0), headPos)
			else
				Camera.CameraType = Enum.CameraType.Custom
			end
		end)
	end
end)

