	}):Play()
	TweenService:Create(WarnStroke, expandInfo, {Transparency = 0}):Play()
	
	-- 4. Esperar y pasar a la GUI Principal
	task.wait(4.5)
	
	local fadeWarn = TweenService:Create(WarnFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 320, 0, 200),
		Position = UDim2.new(0.5, -160, 0.5, -100)
	})
	TweenService:Create(WarnTitle, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
	TweenService:Create(WarnText, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
	TweenService:Create(WarnStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
	
	fadeWarn:Play()
	fadeWarn.Completed:Wait()
	if rainbowConnection then rainbowConnection:Disconnect() end
	WarnFrame:Destroy()
	
	-- 5. Entrada de la GUI Principal
	MainFrame.Visible = true
	MainFrame.Size = UDim2.new(0, 210, 0, 200)
	MainFrame.Position = UDim2.new(0.5, -105, 0.5, -100)
	
