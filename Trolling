-- SISTEMA DE ESP / V-MARKER INTEGRADO
local selectedPlayer = nil
local currentHighlight = nil
local currentBillboard = nil
local espConnection = nil

local function removeESP()
	if espConnection then espConnection:Disconnect() espConnection = nil end
	if currentHighlight then currentHighlight:Destroy() currentHighlight = nil end
	if currentBillboard then currentBillboard:Destroy() currentBillboard = nil end
end

local function applyESP(player)
	removeESP()
	if not player or not player.Character then return end

	-- Flecha V-Marker
	local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
	if head then
		local bb = Instance.new("BillboardGui")
		bb.Name = "TargetTracker_VectorMarker"
		bb.Size = UDim2.new(0, 140, 0, 60)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = head

		local vectorPointer = Instance.new("TextLabel")
		vectorPointer.Size = UDim2.new(1, 0, 0.5, 0)
		vectorPointer.BackgroundTransparency = 1
		vectorPointer.Text = "▼"
		vectorPointer.TextColor3 = Color3.fromRGB(255, 40, 40)
		vectorPointer.TextSize = 24
		vectorPointer.Font = Enum.Font.SourceSansBold
		vectorPointer.Parent = bb

		local labelTag = Instance.new("TextLabel")
		labelTag.Size = UDim2.new(1, 0, 0.5, 0)
		labelTag.Position = UDim2.new(0, 0, 0.5, 0)
		labelTag.BackgroundTransparency = 1
		labelTag.Text = "[ " .. string.upper(player.DisplayName) .. " ]"
		labelTag.TextColor3 = Color3.fromRGB(255, 255, 255)
		labelTag.TextSize = 12
		labelTag.Font = Enum.Font.SourceSansBold
		labelTag.Parent = bb

		bb.Parent = player.Character
		currentBillboard = bb
	end

	-- Aura ESP con límite de distancia
	local highlight = Instance.new("Highlight")
	highlight.Name = "TargetTracker_Highlight"
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 40, 40)
	highlight.OutlineTransparency = 0
	highlight.Adornee = player.Character
	highlight.Parent = player.Character
	currentHighlight = highlight

	espConnection = RunService.RenderStepped:Connect(function()
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local targetChar = player.Character
		local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

		if myHRP and targetHRP and currentHighlight then
			local distance = (myHRP.Position - targetHRP.Position).Magnitude
			if distance <= 150 then
				currentHighlight.Enabled = true
			else
				currentHighlight.Enabled = false
			end
		end
	end)
end

