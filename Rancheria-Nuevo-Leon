local function actualizarMira(character)
    if not character then return end
    local function chequearTool()
        crosshairGui.Enabled = (character:FindFirstChildOfClass("Tool") ~= nil)
    end
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then crosshairGui.Enabled = true end
    end)
    character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then task.defer(chequearTool) end
    end)
    chequearTool()
end

if localPlayer.Character then actualizarMira(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(actualizarMira)
