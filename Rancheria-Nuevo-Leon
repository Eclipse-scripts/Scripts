task.spawn(function()
    local parentTarget = gethui and gethui() or (syn and syn.protect_gui and CoreGui) or localPlayer:WaitForChild("PlayerGui")

    if parentTarget:FindFirstChild("EclipseCrosshair") then
        parentTarget.EclipseCrosshair:Destroy()
    end

    local crosshairGui = Instance.new("ScreenGui")
    crosshairGui.Name = "EclipseCrosshair"
    crosshairGui.ResetOnSpawn = false
    crosshairGui.Enabled = false
    crosshairGui.Parent = parentTarget

    local center = Instance.new("Frame")
    center.Size = UDim2.new(0, 0, 0, 0)
    center.Position = UDim2.new(0.5, 0, 0.40, 0)
    center.BackgroundTransparency = 1
    center.Parent = crosshairGui

    local colorMira = Color3.fromRGB(0, 255, 170)
    local gap, length, thickness = 3, 8, 2

    local top = Instance.new("Frame", center)
    top.Size = UDim2.new(0, thickness, 0, length)
    top.Position = UDim2.new(0, -thickness/2, 0, -gap - length)
    top.BackgroundColor3 = colorMira
    top.BorderSizePixel = 0

    local bottom = Instance.new("Frame", center)
    bottom.Size = UDim2.new(0, thickness, 0, length)
    bottom.Position = UDim2.new(0, -thickness/2, 0, gap)
    bottom.BackgroundColor3 = colorMira
    bottom.BorderSizePixel = 0

    local left = Instance.new("Frame", center)
    left.Size = UDim2.new(0, length, 0, thickness)
    left.Position = UDim2.new(0, -gap - length, 0, -thickness/2)
    left.BackgroundColor3 = colorMira
    left.BorderSizePixel = 0

    local right = Instance.new("Frame", center)
    right.Size = UDim2.new(0, length, 0, thickness)
    right.Position = UDim2.new(0, gap, 0, -thickness/2)
    right.BackgroundColor3 = colorMira
    right.BorderSizePixel = 0

    local function actualizarMira(character)
        if not character then return end
        local function chequearTool()
            crosshairGui.Enabled = (character:FindFirstChildOfClass("Tool") ~= nil)
        end
        character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then crosshairGui.Enabled = true end
        end)
        character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.defer(chequearTool) end
        end)
        chequearTool()
    end

    if localPlayer.Character then actualizarMira(localPlayer.Character) end
    localPlayer.CharacterAdded:Connect(actualizarMira)
end)

-- 4. MUNICIÓN INFINITA OPTIMIZADA (Loop de 1 segundo en segundo plano)
task.spawn(function()
    while true do
        task.wait(1)
        
        -- Munición de vehículos
        local vehicles = Workspace:FindFirstChild("Vehicles")
        if vehicles then
            for _, veh in ipairs(vehicles:GetChildren()) do
                local stats = veh:FindFirstChild("Misc") and veh.Misc:FindFirstChild("50cal") and veh.Misc["50cal"]:FindFirstChild("Stats")
                if stats and stats:FindFirstChild("Ammo") then
                    stats.Ammo.Value = INFINITO
                end
            end
        end

        -- Munición del jugador (ACS)
        pcall(function()
            for _, scr in ipairs(localPlayer:GetDescendants()) do
                if scr:IsA("LocalScript") and (scr.Name:find("ACS") or scr.Name:find("Client")) then
                    if getsenv then
                        local env = getsenv(scr)
                        if env.Ammo ~= nil then env.Ammo = INFINITO end
                        if env.StoredAmmo ~= nil then env.StoredAmmo = INFINITO end
                        if env.Mag ~= nil then env.Mag = INFINITO end
                        if env.Variaveis then
                            if env.Variaveis.Ammo ~= nil then env.Variaveis.Ammo = INFINITO end
                            if env.Variaveis.StoredAmmo ~= nil then env.Variaveis.StoredAmmo = INFINITO end
                        end
                    end
                end
            end

            local char = localPlayer.Character
            if char then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") then
                        local settingsModule = tool:FindFirstChild("ACS_Settings") or to
